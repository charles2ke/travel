{
  "name": "travel-itinerary",
  "version": "1.0.0",
  "private": true,
  "description": "Tito & Kanika US East Coast trip itinerary",
  "homepage": "https://charles2ke.github.io/travel/",
  "scripts": {
    "test": "jest --coverage",
    "test:smoke": "playwright test",
    "test:all": "npm test && npm run test:smoke",
    "package": "zip -r site-package.zip index.html titos_travel_map_progress_with_cities.html us-east-coast-itinerary-day6-rebalanced-museum.html assets/ README.md LICENSE",
    "serve": "serve . --listen 1985 --no-clipboard"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "serve": "^14.2.6"
  },
  "jest": {
    "testEnvironment": "jest-environment-jsdom",
    "testMatch": ["**/tests/**/*.test.js"],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": ["assets/js/**/*.js"]
  }
}
